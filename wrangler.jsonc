{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texthighlighter",
  "compatibility_date": "2026-06-13",
  "main": "src/worker.js",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "VISITORS", "class_name": "VisitorCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitorCounter"] }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
